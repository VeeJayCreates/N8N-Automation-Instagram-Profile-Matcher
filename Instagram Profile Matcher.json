      "parameters": {
        "jsCode": "// Get all items from both source sheets\nconst allProfiles = $input.all();\n\n// Get the business requirement from the form response\nconst formData = $('Received new client requirement').first().json;\n\n// Filter profiles based on requirements\n// This is a simple example - customize the matching logic based on your needs\nconst matchingProfiles = allProfiles.filter(profile => {\n  // Example: match by niche, location, budget, etc.\n  // Customize this logic based on your form fields and sheet columns\n  return true; // For now, return all profiles\n});\n\nreturn matchingProfiles.map(profile => ({ json: profile.json }));"
