    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const followerValue = $input.item.json.Followers;\nconst formData = $(\"Received new client requirement\").first().json;\nconst minFollowers = formData[\"Min Followers\"];\nconst maxFollowers = formData[\"Max Followers\"];\n\nlet numericFollowers = followerValue;\n\nif (typeof followerValue === \"string\") {\n  const lowerValue = followerValue.toLowerCase().trim();\n  \n  if (lowerValue.includes(\"k\")) {\n    const numPart = parseFloat(lowerValue.replace(\"k\", \"\"));\n    numericFollowers = Math.round(numPart * 1000);\n  } else if (lowerValue.includes(\"m\")) {\n    const numPart = parseFloat(lowerValue.replace(\"m\", \"\"));\n    numericFollowers = Math.round(numPart * 1000000);\n  } else if (lowerValue.includes(\"l\")) {\n    const numPart = parseFloat(lowerValue.replace(\"l\", \"\"));\n    numericFollowers = Math.round(numPart * 100000);\n  } else {\n    numericFollowers = parseInt(followerValue) || followerValue;\n  }\n}\n\nif (numericFollowers >= minFollowers && numericFollowers <= maxFollowers) {\n  return {\n    ...($input.item.json),\n    Followers: numericFollowers\n  };\n}\n\nreturn null;"
      },
